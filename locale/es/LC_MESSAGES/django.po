#: templates/registration/password_reset_done.html:8
msgid "Check your email"
msgstr "Revisa tu correo"

#: templates/registration/password_reset_done.html:10
msgid ""
"If an account uses that email, we've sent it a link to choose a new "
"password. It expires in 1 hour."
msgstr ""
"Si hay una cuenta con ese correo, le enviamos un enlace para elegir una "
"nueva contraseña. Expira en 1 hora."

#: templates/registration/password_reset_done.html:11
msgid "Didn't get it? Check your spam folder."
msgstr "¿No te llegó? Revisa la carpeta de spam."

#: templates/registration/password_reset_email.txt:3
msgid ""
"Someone asked to reset the password of your account. To choose a new one, "
"open this link (it works once and for 1 hour):"
msgstr ""
"Alguien pidió restablecer la contraseña de tu cuenta. Para elegir una nueva,"
" abre este enlace (funciona una sola vez y durante 1 hora):"

#: templates/registration/password_reset_email.txt:7
msgid "If it wasn't you, ignore this email: your password stays the same."
msgstr "Si no fuiste tú, ignora este correo: tu contraseña sigue igual."

#: templates/registration/password_reset_form.html:9
msgid ""
"Enter your account's email and we'll send you a link to choose a new "
"password. The link works once and for 1 hour."
msgstr ""
"Escribe el correo de tu cuenta y te enviaremos un enlace para elegir una "
"nueva contraseña. El enlace funciona una sola vez y durante 1 hora."

#: templates/registration/password_reset_form.html:13
msgid "Send the link"
msgstr "Enviar el enlace"

#: templates/registration/password_reset_form.html:15
msgid "Back to log in"
msgstr "Volver a iniciar sesión"

#: templates/registration/password_reset_subject.txt:1
msgid "Reset your password"
msgstr "Restablece tu contraseña"

