#: templates/registration/verify_email.txt:3
msgid ""
"To start booking, verify your email by opening this link (it works for 1 "
"day):"
msgstr ""
"Para empezar a reservar, verifica tu correo abriendo este enlace (funciona "
"durante 1 día):"

#: templates/registration/verify_email.txt:7
msgid "If you didn't create an account, ignore this email."
msgstr "Si no creaste una cuenta, ignora este correo."

#: templates/registration/verify_email_invalid.html:9
msgid ""
"It expired (links last 1 day), or it was sent to an email the account no "
"longer uses."
msgstr ""
"Expiró (los enlaces duran 1 día) o se envió a un correo que la cuenta ya no "
"usa."

#: templates/registration/verify_email_invalid.html:10
msgid "Log in and ask for a new link from the booking page."
msgstr "Inicia sesión y pide un enlace nuevo desde la página de reservas."

