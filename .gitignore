# --- Secrets: never public ---------------------------------------------------
# Each machine has its own .env (copied by hand to the server). Only the
# example, with placeholder values, goes to git.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
id_*
*.sqlite3
*.sql
*.sql.gz
*.dump

# --- User uploads (photos of the courts): stay on each server -----------------
/media/*
!/media/.gitkeep

# --- Generated -----------------------------------------------------------------
__pycache__/
*.py[cod]
/staticfiles/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.log

# Tailwind and Dart Sass standalone executables (downloaded separately, not in git)
/bin/

# --- Local environment and editors ---------------------------------------------
# Personal, detailed notes of the project (the public one is README.md).
.readme.md
.venv/
venv/
.idea/
.vscode/
*.swp
.DS_Store
